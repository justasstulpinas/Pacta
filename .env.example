# Copy this file to .env and fill in real values. Never commit .env.

# Django-style secret key — generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-generate-a-64-char-hex-string

# Local dev: sqlite:///./melno.db  |  Production: postgresql+psycopg2://user:pass@host/db
DATABASE_URL=sqlite:///./melno.db

# Minutes until access token expires (default 30)
ACCESS_TOKEN_EXPIRE_MINUTES=30

# URL of the Next.js frontend (used for CORS and email links)
FRONT_END_URL=http://localhost:3000

# Public URL of this backend (used in email links)
APP_URL=http://localhost:3000

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=re_your_key_here

# Sender address configured in Resend
EMAIL_FROM=onboarding@resend.dev

# development | production
ENVIRONMENT=development
